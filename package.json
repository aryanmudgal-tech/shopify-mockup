{
  "name": "before-you-buy",
  "private": true,
  "version": "0.1.0",
  "description": "A check that runs before an agent hands a buyer to checkout: price at the door, a sample, and what a return costs.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "dev:live": "DATA_MODE=live PORT=5174 tsx watch --clear-screen=false server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
